# Environment Variables Template
# Copy this file to .env and fill in your values

# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Database Configuration (SQLite)
# For local development, you can use relative path:
# DATABASE_URL=sqlite:///db.sqlite3
# For production (Docker/Railway), use absolute path:
DATABASE_URL=sqlite:////app/data/db.sqlite3

# Superuser Configuration (for initial deployment)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@mpbenti.com.au
DJANGO_SUPERUSER_PASSWORD=change-this-secure-password